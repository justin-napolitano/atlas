{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas",
  "version": "0.2.0",
  "identifier": "org.researchatlas.desktop",
  "build": { "frontendDist": "splash" },
  "app": {
    "windows": [],
