{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:vault-page:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "path", "title", "title_mode", "thought_type", "state", "links"],
  "properties": {
    "format": {"const": 1, "type": "integer"},
    "id": {"type": "string", "pattern": "^urn:research:notebook:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "path": {"type": "string", "pattern": "^notes/[0-9a-f-]{36}\\.md$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "title_mode": {"enum": ["automatic", "manual"]},
    "thought_type": {"enum": ["note", "question", "interpretation", "objection", "decision", "principle", "skill"]},
    "state": {"const": "active"},
    "links": {"type": "array", "maxItems": 25, "items": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "rationale"],
      "properties": {"kind": {"const": "entry"}, "id": {"type": "string", "maxLength": 500}, "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}}
    }}
  }
}
