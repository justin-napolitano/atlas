      "metrics": [
        {
          "name": "record_count",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "COUNT(DISTINCT records.id)"
              }
            ]
          },
          "description": "Count of visible records at record grain; apply permission/project filters before aggregation."
        },
        {
          "name": "read_count",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "COUNT(DISTINCT CASE WHEN personal_states.reading = 'read' THEN personal_states.record_id END)"
              }
            ]
          },
          "description": "Private owner reading progress; not evaluation or verification."
        }
      ],
      "custom_extensions": [
        {
          "vendor_name": "COMMON",
          "data": "{\"research_platform\": {\"policy_document\": \"../src/islam_research/policies/research-policy.json\", \"policy_version\": 1, \"authorization\": \"backend-enforced; metadata is not permission\", \"execution\": \"registered operations only; never execute model-supplied SQL\"}}"
