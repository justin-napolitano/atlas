{
  "components": {
    "schemas": {
      "FeatureInput": {
        "additionalProperties": false,
        "properties": {
          "basis": {
            "default": "",
            "maxLength": 2000,
            "title": "Basis",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "title": "FeatureInput",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PersonalInput": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "default": "unreviewed",
            "enum": [
              "unreviewed",
              "relevant",
              "not_relevant",
              "read_later"
            ],
            "title": "Decision",
            "type": "string"
          },
          "expected_revision": {
            "default": 0,
            "minimum": 0.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "note": {
            "default": "",
            "maxLength": 10000,
            "title": "Note",
            "type": "string"
          },
          "project_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Project Id",
            "type": "string"
          },
          "reading": {
            "default": "unread",
            "enum": [
              "unread",
              "reading",
              "read"
            ],
            "title": "Reading",
            "type": "string"
          },
          "record_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Record Id",
            "type": "string"
          }
        },
        "required": [
          "record_id",
          "project_id"
        ],
        "title": "PersonalInput",
        "type": "object"
      },
      "ProjectInput": {
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Project Id",
            "type": "string"
          },
          "scope": {
            "default": "",
            "maxLength": 10000,
            "title": "Scope",
            "type": "string"
          },
          "title": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "project_id",
          "title"
        ],
        "title": "ProjectInput",
        "type": "object"
      },
      "RankCandidate": {
        "additionalProperties": false,
        "properties": {
          "features": {
            "additionalProperties": {
              "$ref": "#/components/schemas/FeatureInput"
            },
            "maxProperties": 12,
            "title": "Features",
            "type": "object"
          },
          "id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "features"
        ],
        "title": "RankCandidate",
        "type": "object"
      },
      "RankInput": {
        "additionalProperties": false,
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/RankCandidate"
            },
            "maxItems": 100,
            "title": "Candidates",
            "type": "array"
          },
          "profile_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Profile Id",
            "type": "string"
          }
        },
        "required": [
          "profile_id",
          "candidates"
        ],
        "title": "RankInput",
        "type": "object"
      },
      "RecordInput": {
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "additionalProperties": true,
            "title": "Attributes",
            "type": "object"
          },
          "expected_revision": {
            "default": 0,
            "minimum": 0.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "kind": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Kind",
            "type": "string"
          },
          "project_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Project Id",
            "type": "string"
          },
          "record_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Record Id",
            "type": "string"
          },
          "summary": {
            "default": "",
            "maxLength": 50000,
            "title": "Summary",
            "type": "string"
          },
          "title": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "record_id",
          "project_id",
          "kind",
          "title"
        ],
        "title": "RecordInput",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
