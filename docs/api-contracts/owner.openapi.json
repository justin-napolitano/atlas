{
  "components": {
    "schemas": {
      "FeatureInput": {
        "additionalProperties": false,
        "properties": {
          "basis": {
            "default": "",
            "maxLength": 2000,
            "title": "Basis",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "title": "FeatureInput",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PersonalInput": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "default": "unreviewed",
            "enum": [
              "unreviewed",
              "relevant",
              "not_relevant",
              "read_later"
            ],
            "title": "Decision",
            "type": "string"
          },
          "expected_revision": {
            "default": 0,
            "minimum": 0.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "note": {
            "default": "",
            "maxLength": 10000,
            "title": "Note",
            "type": "string"
          },
          "project_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Project Id",
            "type": "string"
          },
          "reading": {
            "default": "unread",
            "enum": [
              "unread",
              "reading",
              "read"
            ],
            "title": "Reading",
            "type": "string"
          },
          "record_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Record Id",
            "type": "string"
          }
        },
        "required": [
          "record_id",
          "project_id"
        ],
        "title": "PersonalInput",
        "type": "object"
      },
      "ProjectInput": {
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Project Id",
            "type": "string"
          },
          "scope": {
            "default": "",
            "maxLength": 10000,
            "title": "Scope",
            "type": "string"
          },
          "title": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "project_id",
          "title"
        ],
        "title": "ProjectInput",
        "type": "object"
      },
      "PublicationApprovalInput": {
        "additionalProperties": false,
        "properties": {
          "expected_revision": {
            "minimum": 0.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "expected_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Expected Sha256",
            "type": "string"
          },
          "preview_id": {
            "pattern": "^publication-[a-f0-9]{32}$",
            "title": "Preview Id",
            "type": "string"
          },
          "rationale": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Rationale",
            "type": "string"
          },
          "rights_checked": {
            "const": true,
            "title": "Rights Checked",
            "type": "boolean"
          }
        },
        "required": [
          "preview_id",
          "expected_sha256",
          "expected_revision",
          "rationale",
          "rights_checked"
        ],
        "title": "PublicationApprovalInput",
        "type": "object"
      },
      "PublicationPreviewInput": {
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Project Id",
            "type": "string"
          },
          "relation_ids": {
            "items": {
              "maxLength": 500,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$",
              "type": "string"
            },
            "maxItems": 300,
            "title": "Relation Ids",
            "type": "array"
          },
          "selections": {
            "items": {
              "$ref": "#/components/schemas/PublicationSelection"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Selections",
            "type": "array"
          }
        },
        "required": [
          "project_id",
          "selections"
        ],
        "title": "PublicationPreviewInput",
        "type": "object"
      },
      "PublicationSelection": {
        "additionalProperties": false,
        "properties": {
          "include_bibliography": {
            "default": false,
            "title": "Include Bibliography",
            "type": "boolean"
          },
          "include_summary": {
            "default": false,
            "title": "Include Summary",
            "type": "boolean"
          },
          "record_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Record Id",
            "type": "string"
          }
        },
        "required": [
          "record_id"
        ],
        "title": "PublicationSelection",
        "type": "object"
      },
      "PublicationWithdrawalInput": {
        "additionalProperties": false,
        "properties": {
          "expected_revision": {
            "minimum": 1.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "project_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Project Id",
            "type": "string"
          },
          "rationale": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Rationale",
            "type": "string"
          }
        },
        "required": [
          "project_id",
          "expected_revision",
          "rationale"
        ],
        "title": "PublicationWithdrawalInput",
        "type": "object"
      },
      "RankCandidate": {
        "additionalProperties": false,
        "properties": {
          "features": {
            "additionalProperties": {
              "$ref": "#/components/schemas/FeatureInput"
            },
            "maxProperties": 12,
            "title": "Features",
            "type": "object"
          },
          "id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "features"
        ],
        "title": "RankCandidate",
        "type": "object"
      },
      "RankInput": {
        "additionalProperties": false,
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/RankCandidate"
            },
            "maxItems": 100,
            "title": "Candidates",
            "type": "array"
          },
          "profile_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Profile Id",
            "type": "string"
          }
        },
        "required": [
          "profile_id",
          "candidates"
        ],
        "title": "RankInput",
        "type": "object"
      },
      "ReadingAnnotationUpdate": {
        "additionalProperties": false,
        "properties": {
          "annotation_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Annotation Id",
            "type": "string"
          },
          "body": {
            "maxLength": 10000,
            "title": "Body",
            "type": "string"
          },
          "expected_revision": {
            "minimum": 1.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "project_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Project Id",
            "type": "string"
          }
        },
        "required": [
          "annotation_id",
          "project_id",
          "body",
          "expected_revision"
        ],
        "title": "ReadingAnnotationUpdate",
        "type": "object"
      },
      "ReadingCaptureInput": {
        "additionalProperties": false,
        "properties": {
          "annotation_uuid": {
            "pattern": "^[a-fA-F0-9-]{36}$",
            "title": "Annotation Uuid",
            "type": "string"
          },
          "body": {
            "default": "",
            "maxLength": 10000,
            "title": "Body",
            "type": "string"
          },
          "capture_kind": {
            "default": "comment",
            "enum": [
              "comment",
              "term_candidate",
              "citation_candidate"
            ],
            "title": "Capture Kind",
            "type": "string"
          },
          "document_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Document Id",
            "type": "string"
          },
          "end": {
            "maximum": 12000.0,
            "minimum": 1.0,
            "title": "End",
            "type": "integer"
          },
          "exact": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Exact",
            "type": "string"
          },
          "project_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Project Id",
            "type": "string"
          },
          "start": {
            "maximum": 12000.0,
            "minimum": 0.0,
            "title": "Start",
            "type": "integer"
          },
          "text_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Text Sha256",
            "type": "string"
          }
        },
        "required": [
          "annotation_uuid",
          "project_id",
          "document_id",
          "text_sha256",
          "start",
          "end",
          "exact"
        ],
        "title": "ReadingCaptureInput",
        "type": "object"
      },
      "ReadingDocumentInput": {
        "additionalProperties": false,
        "properties": {
          "edition": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Edition",
            "type": "string"
          },
          "locator": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Locator",
            "type": "string"
          },
          "project_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Project Id",
            "type": "string"
          },
          "representation_url": {
            "default": "",
            "maxLength": 2000,
            "title": "Representation Url",
            "type": "string"
          },
          "source_record_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Source Record Id",
            "type": "string"
          },
          "text": {
            "maxLength": 12000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "project_id",
          "source_record_id",
          "edition",
          "locator",
          "text"
        ],
        "title": "ReadingDocumentInput",
        "type": "object"
      },
      "RecordInput": {
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "additionalProperties": true,
            "title": "Attributes",
            "type": "object"
          },
          "expected_revision": {
            "default": 0,
            "minimum": 0.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "kind": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Kind",
            "type": "string"
          },
          "project_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Project Id",
            "type": "string"
          },
          "record_id": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Record Id",
            "type": "string"
          },
          "summary": {
            "default": "",
            "maxLength": 50000,
            "title": "Summary",
            "type": "string"
          },
          "title": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "record_id",
          "project_id",
          "kind",
          "title"
        ],
        "title": "RecordInput",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
